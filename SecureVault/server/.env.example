# Copy to .env (or just run `npm run setup` from the project root, which does this
# and generates fresh random secrets for you).
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/securevault
CLIENT_ORIGIN=http://localhost:5173

# 32+ random chars. Signs short-lived access tokens.
JWT_ACCESS_SECRET=
# EXACTLY 64 hex chars (32 bytes). Wraps per-file data keys and MFA secrets.
# KEEP THIS OUT OF THE DATABASE AND BACK IT UP: if it is lost, encrypted files cannot be recovered.
MASTER_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
MAX_FILE_MB=25

# Optional email (password reset + share notices). If SMTP_HOST is empty,
# emails are NOT sent; in development the message is printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SecureVault <no-reply@securevault.local>"

# Optional local HTTPS (see README). Leave empty to use plain HTTP in development.
SSL_KEY_PATH=
SSL_CERT_PATH=
